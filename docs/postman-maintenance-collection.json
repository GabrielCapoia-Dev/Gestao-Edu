{
  "info": {
    "_postman_id": "d34f8f82-ec83-4c65-a089-gestao-edu-maintenance",
    "name": "Gestao Edu - Maintenance API",
    "description": "Rotas protegidas para manutencao de producao: login admin, cache, permissoes e migrations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://gestaoedu.umuarama.pr.gov.br"
    },
    {
      "key": "admin_email",
      "value": "admin@admin.com"
    },
    {
      "key": "admin_password",
      "value": "SUA_SENHA"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login - Gerar Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/maintenance/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "maintenance",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.access_token) {",
              "  pm.collectionVariables.set('access_token', json.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Atualizar Permissoes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/maintenance/permissions/sync",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "maintenance",
            "permissions",
            "sync"
          ]
        }
      }
    },
    {
      "name": "3. Limpar e Recompilar Caches",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/maintenance/cache/rebuild",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "maintenance",
            "cache",
            "rebuild"
          ]
        }
      }
    },
    {
      "name": "4. Rodar Migrations",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/maintenance/migrate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "maintenance",
            "migrate"
          ]
        }
      }
    }
  ]
}
