################################
# APP
################################
APP_NAME="Gestão Edu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_PORT=8020
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

################################
# DOCKER PORTS
################################
DOCKER_APP_PORT=8020
DOCKER_HTTP_PORT=8020
DOCKER_HTTPS_PORT=8443
DOCKER_DB_PORT=3309
DOCKER_PHPMYADMIN_PORT=8085

################################
# GOOGLE OAUTH
################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/oauth/callback/google

################################
# SECURITY
################################
BCRYPT_ROUNDS=12

################################
# LOG
################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################
# DATABASE
################################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gestao-edu
DB_USERNAME=root
DB_PASSWORD=root

MYSQL_ROOT_PASSWORD=root

################################
# CACHE / SESSION
################################
CACHE_DRIVER=redis
CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

################################
# QUEUE
################################
QUEUE_CONNECTION=redis
PERMISSION_CACHE_STORE=redis
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_QUEUE_TRIES=3
NOTIFICATIONS_QUEUE_TIMEOUT=60
NOTIFICATIONS_QUEUE_BACKOFF=10,60,300
NOTIFICATIONS_QUEUE_SLEEP=3
NOTIFICATIONS_QUEUE_REST=0
NOTIFICATIONS_QUEUE_MEMORY_MB=384
NOTIFICATIONS_QUEUE_CPUS=0.25
NOTIFICATIONS_QUEUE_MEM_LIMIT=512m
QUEUE_WORKER_MAX_TIME=3600
QUEUE_WORKER_MAX_JOBS=500
NOTIFICATIONS_UNREAD_COUNT_CACHE_TTL=30
NOTIFICATIONS_TOPBAR_POLL_INTERVAL_MS=60000
NOTIFICATIONS_CENTER_POLL_INTERVAL_MS=30000
EXPORTS_QUEUE=exports
EXPORTS_JOB_TIMEOUT=900
EXPORTS_QUEUE_TRIES=3
EXPORTS_MAX_ACTIVE_PER_USER=3
EXPORTS_STALLED_QUEUED_AFTER_MINUTES=30
EXPORTS_STALLED_RUNNING_AFTER_MINUTES=45
EXPORTS_STALLED_MAX_RECOVERY_ATTEMPTS=3
EXPORTS_QUEUE_SLEEP=5
EXPORTS_QUEUE_REST=1
EXPORTS_QUEUE_NICE=10
EXPORTS_QUEUE_MEMORY_MB=384
EXPORTS_PHP_MEMORY_LIMIT=512M
EXPORTS_QUEUE_CPUS=0.50
EXPORTS_QUEUE_MEM_LIMIT=768m
IMPORTS_QUEUE=imports
IMPORTS_JOB_TIMEOUT=1800
IMPORTS_QUEUE_TRIES=2
IMPORTS_QUEUE_SLEEP=5
IMPORTS_QUEUE_REST=1
IMPORTS_QUEUE_NICE=10
IMPORTS_QUEUE_MEMORY_MB=384
IMPORTS_PHP_MEMORY_LIMIT=512M
IMPORTS_QUEUE_CPUS=0.50
IMPORTS_QUEUE_MEM_LIMIT=768m
DEFAULT_QUEUE_TIMEOUT=300
DEFAULT_QUEUE_TRIES=3
DEFAULT_QUEUE_MEMORY_MB=384
DEFAULT_QUEUE_CPUS=0.25
DEFAULT_QUEUE_MEM_LIMIT=512m

AVALIACOES_DASHBOARD_QUEUE_CONNECTION=dashboard_redis
AVALIACOES_DASHBOARD_REDIS_CONNECTION=default
AVALIACOES_DASHBOARD_QUEUE=dashboard
AVALIACOES_DASHBOARD_QUEUE_RETRY_AFTER=900
AVALIACOES_DASHBOARD_INCREMENTAL_TIMEOUT=120
AVALIACOES_DASHBOARD_INCREMENTAL_TRIES=3
AVALIACOES_DASHBOARD_INCREMENTAL_MAX_ATTEMPTS=9
AVALIACOES_DASHBOARD_INCREMENTAL_RECOVERY_AFTER=180
AVALIACOES_DASHBOARD_INCREMENTAL_BACKOFF=10,30,60
AVALIACOES_DASHBOARD_INCREMENTAL_LOCK_TTL=180
AVALIACOES_DASHBOARD_INCREMENTAL_UNIQUE_TTL=3600
AVALIACOES_DASHBOARD_SCOPE_MAX_ATTEMPTS=9
AVALIACOES_DASHBOARD_FULL_TIMEOUT=600
AVALIACOES_DASHBOARD_FULL_TRIES=2
AVALIACOES_DASHBOARD_FULL_BACKOFF=60,180
AVALIACOES_DASHBOARD_FULL_LOCK_TTL=720
AVALIACOES_DASHBOARD_FULL_UNIQUE_TTL=3600
AVALIACOES_DASHBOARD_QUEUE_WORKER_TIMEOUT=600
AVALIACOES_DASHBOARD_QUEUE_TRIES=3
AVALIACOES_DASHBOARD_QUEUE_SLEEP=3
AVALIACOES_DASHBOARD_QUEUE_REST=1
AVALIACOES_DASHBOARD_QUEUE_NICE=10
AVALIACOES_DASHBOARD_QUEUE_MEMORY_MB=384
AVALIACOES_DASHBOARD_QUEUE_MAX_JOBS=250
AVALIACOES_DASHBOARD_PHP_MEMORY_LIMIT=384M

# Persistência das avaliações: json | shadow | relacional
AVALIACOES_PERSISTENCIA_DRIVER=json
# Ative apenas durante a janela curta de rollback após o cutover.
AVALIACOES_PROJETAR_JSON_LEGADO=false

################################
# FILESYSTEM
################################
FILESYSTEM_DISK=local

################################
# REDIS
################################
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=2100

################################
# MAIL
################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

################################
# AWS
################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

################################
# VITE
################################
VITE_APP_NAME="${APP_NAME}"

################################
# PERFORMANCE
################################
PERF_HEARTBEAT_INTERVAL=45
PERF_PRESENCE_TOUCH_MIN_INTERVAL=35
PERF_POLL_ONLINE_USERS=45
PERF_POLL_EXPORTS_TABLE=30
PERF_POLL_EXPORTS_AUTO_DOWNLOAD=20
PERF_CACHE_ONLINE_USERS=30
PERF_CACHE_ONLINE_COUNT=30
PERF_CACHE_USERS_COUNT=300
PERF_CACHE_NOTIFICATION_FORM_OPTIONS=600
PERF_CACHE_ACTIVE_EXPORTS=30
PERF_CACHE_INVENTORY_DASHBOARD=60
PERF_CACHE_REPORTS_DASHBOARD=60
PERF_INSTRUMENTATION_ENABLED=false
PERF_LIVEWIRE_INSTRUMENTATION_ENABLED=false
PERF_INSTRUMENTATION_LOG_ALL=false
PERF_SLOW_REQUEST_MS=2000
