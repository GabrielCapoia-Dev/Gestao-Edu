################################
# APP
################################
APP_NAME="Gestão Edu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_PORT=8020
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

################################
# DOCKER PORTS
################################
DOCKER_APP_PORT=8020
DOCKER_HTTP_PORT=8020
DOCKER_HTTPS_PORT=8443
DOCKER_DB_PORT=3309
DOCKER_PHPMYADMIN_PORT=8085

################################
# GOOGLE OAUTH
################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/oauth/callback/google

################################
# SECURITY
################################
BCRYPT_ROUNDS=12

################################
# LOG
################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################
# DATABASE
################################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gestao-edu
DB_USERNAME=root
DB_PASSWORD=root

MYSQL_ROOT_PASSWORD=root

################################
# CACHE / SESSION
################################
CACHE_DRIVER=redis
CACHE_STORE=redis

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

################################
# QUEUE
################################
QUEUE_CONNECTION=redis
PERMISSION_CACHE_STORE=redis
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_QUEUE_TRIES=3
NOTIFICATIONS_QUEUE_TIMEOUT=60
NOTIFICATIONS_QUEUE_BACKOFF=10,60,300
NOTIFICATIONS_QUEUE_SLEEP=3
NOTIFICATIONS_QUEUE_REST=0
NOTIFICATIONS_QUEUE_MEMORY_MB=128
NOTIFICATIONS_QUEUE_CPUS=0.25
NOTIFICATIONS_QUEUE_MEM_LIMIT=256m
NOTIFICATIONS_UNREAD_COUNT_CACHE_TTL=30
NOTIFICATIONS_TOPBAR_POLL_INTERVAL_MS=60000
NOTIFICATIONS_CENTER_POLL_INTERVAL_MS=30000
EXPORTS_QUEUE=exports
EXPORTS_JOB_TIMEOUT=900
EXPORTS_MAX_ACTIVE_PER_USER=3
EXPORTS_QUEUE_SLEEP=5
EXPORTS_QUEUE_REST=1
EXPORTS_QUEUE_NICE=10
EXPORTS_QUEUE_MEMORY_MB=384
EXPORTS_QUEUE_CPUS=0.50
EXPORTS_QUEUE_MEM_LIMIT=512m

################################
# FILESYSTEM
################################
FILESYSTEM_DISK=local

################################
# REDIS
################################
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=1200

################################
# MAIL
################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

################################
# AWS
################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

################################
# VITE
################################
VITE_APP_NAME="${APP_NAME}"
