            "purpose": "any maskable"
        },
        {
            "src": "/pwa/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Acesso",
            "short_name": "Acesso",
            "description": "Abra os modulos de usuarios, dominios e niveis.",
            "url": "/app/acesso"
        },
        {
            "name": "Relatorios",
            "short_name": "Relatorios",
            "description": "Abra as consultas mobile do sistema.",
            "url": "/app/relatorios"
        }
    ]
}
