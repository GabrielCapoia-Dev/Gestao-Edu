{
  "name": "gestao-edu-2-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API independente do Gestão Edu 2.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "mysql2": "3.15.3",
    "reflect-metadata": "0.2.2",
    "redis": "5.8.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "jest": "30.2.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  }
}
